---
import BaseLayout from '../layouts/BaseLayout.astro';
import { base } from '../lib/base';

const links = [
  { href: 'liga', title: 'Liga semanal', desc: 'Classificação atualizada da liga na Muito!' },
  { href: 'amistosos', title: 'Amistosos', desc: 'Resultados contra outros times.' },
  { href: 'torneios', title: 'Torneios', desc: 'Próximos torneios na região.' },
  { href: 'galeria', title: 'Galeria', desc: 'Fotos dos eventos e da liga.' },
];
---

<BaseLayout title="Início">
  <section class="flex flex-col items-center gap-6 py-10 text-center">
    <img
      src={`${base}images/pranksters-logo.jpg`}
      alt="Logo Team Pranksters"
      width="160"
      height="160"
      class="h-40 w-40 rounded-full ring-4 ring-prank-gold/50"
    />
    <div>
      <h1 class="font-display text-4xl font-bold sm:text-5xl">
        TEAM <span class="text-prank-gold">PRANKSTERS</span>
      </h1>
      <p class="mt-3 max-w-xl text-white/60">
        Time de Pokémon VGC disputando a liga semanal na loja Muito! e amistosos pela região.
        Acompanhe resultados, torneios e fotos por aqui.
      </p>
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-2">
    {
      links.map((l) => (
        <a
          href={`${base}${l.href}`}
          class="rounded-lg border border-prank-border bg-prank-surface p-5 transition-colors hover:border-prank-gold"
        >
          <h2 class="font-display text-xl font-semibold text-white">{l.title}</h2>
          <p class="mt-1 text-sm text-white/50">{l.desc}</p>
        </a>
      ))
    }
  </section>
</BaseLayout>
